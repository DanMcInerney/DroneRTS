{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"], "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "allowImportingTsExtensions": true, "types": ["node"]
  },
  "include": ["server", "client", "shared", "tests", "scripts"]
}
